# ====================================================
# BASIC Parser Studio - Backend Environment Variables
# ====================================================

# Port for the Express server (Render automatically sets this to 10000)
PORT=10000

# Node Environment ('development' | 'production')
NODE_ENV=production

# Path to the compiled Flex/Bison BASIC parser executable
# In Docker on Render: /app/parser/basic_parser
# In local development: ../parser/basic_parser.exe (Windows) or ../parser/basic_parser (Linux)
PARSER_BIN_PATH=/app/parser/basic_parser

# Frontend origin allowed by CORS in production (no trailing slash)
# Comma-separated for multiple origins, e.g.:
# FRONTEND_URL=https://basic-parser-frontend.onrender.com,https://yourcustomdomain.com
FRONTEND_URL=https://basic-parser-frontend.onrender.com
